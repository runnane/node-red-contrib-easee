{
  "name": "@runnane/node-red-contrib-easee",
  "version": "0.7.6",
  "description": "Module for streaming Easee data. Based on node-red-contrib-signalrcore",
  "author": "Jon Tungland",
  "homepage": "https://github.com/runnane/node-red-contrib-easee",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/runnane/node-red-contrib-easee"
  },
  "bugs": {
    "url": "https://github.com/runnane/node-red-contrib-easee/issues"
  },
  "keywords": [
    "easee",
    "charger",
    "ev",
    "signalr",
    "node-red"
  ],
  "packageManager": "pnpm@10.34.5",
  "files": [
    "dist/easee-client"
  ],
  "dependencies": {
    "@microsoft/signalr": "9.0.6"
  },
  "node-red": {
    "nodes": {
      "easee-configuration": "dist/easee-client/easee-configuration.js",
      "easee-rest-client": "dist/easee-client/easee-rest-client.js",
      "charger-streaming-client": "dist/easee-client/charger-streaming-client.js"
    },
    "version": ">=2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "gates": "pnpm check && pnpm typecheck && pnpm build && pnpm test:coverage && pnpm test:compat",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('easee-client', 'dist/easee-client', { recursive: true, filter: (src) => !src.endsWith('.ts') })\"",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:compat": "node dist/scripts/check-node-loads.js",
    "audit:prod": "node dist/scripts/audit-production.js",
    "dep-update": "pnpm dlx npm-check-updates -u && pnpm install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^22.0.0",
    "@types/node-red": "^1.3.5",
    "@types/node-red-node-test-helper": "^0.3.5",
    "@vitest/coverage-v8": "^5.0.1",
    "node-red": "^4.1.0",
    "node-red-node-test-helper": "^0.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "packageExtensions": {
      "node-red@4": {
        "dependencies": {
          "@node-red/registry": "4.1.8"
        }
      }
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "i18next>typescript": "7"
      }
    }
  }
}
